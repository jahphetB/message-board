<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title %></title>
	</head>
	<body class="page">
		<main class="main">
			<h1 class="page-title"><%= title %></h1>
			<p class="message-user"><%= message.user %></p>
			<p class="message-text"><%= message.text %></p>
			<p class="message-date"><%= message.added.toLocaleString() %></p>
			<a class="home-link" href="/">Back to messages</a>
		</main>
	</body>
</html>